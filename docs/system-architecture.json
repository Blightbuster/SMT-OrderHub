omain Entities<br/>(Order, Board, Component)\\\"]\\n        JoinEntities[\\\"Join Entities<br/>(OrderBoard, BoardComponent)\\\"]\\n        Contracts[\\\"Core Contracts<br/>(IHasRowVersion)\\\"]\\n    end\\n    class Entities,JoinEntities,Contracts domainLayer;\\n\\n    subgraph Infrastructure_Layer [\\\"Infrastructure Layer (OrderHub.Infrastructure)\\\"]\\n        DbContext[\\\"SmtDbContext<br/>(EF Core + IdentityDbContext)\\\"]\\n        RepoImpls[\\\"Repository Implementations<br/>(OrderRepository, BoardRepository, ComponentRepository)\\\"]\\n        Migrations[\\\"EF Core Migrations\\\"]\\n    end\\n    class DbContext,RepoImpls,Migrations infraLayer;\\n\\n    subgraph External_Storage [\\\"Persistence & External Clients\\\"]\\n        SQLite[(\\\"SQLite Database<br/>smt.db\\\")]\\n        SMTLine[\\\"SMT Production Line<br/>(JSON Consumer)\\\"]\\n    end\\n    class SQLite,SMTLine external;\\n\\n    %% Dependencies across layers\\n    UI --> ApiClient\\n    UI --> HubClient\\n    ApiClient -->|HTTP REST / JSON / Cookies| Controllers\\n    ApiClient -->|Auth Requests| IdentityEndpoints\\n    HubClient -.->|WebSocket / SSE| SignalRHub\\n\\n    Controllers --> Filters\\n    Controllers --> RepoInterfaces\\n    Controllers --> ProductionService\\n    Controllers --> DTOs\\n    Controllers -.->|Broadcast OrderModifiedEvent| SignalRHub\\n\\n    ProductionService --> RepoInterfaces\\n    ProductionService --> DTOs\\n    ProductionService --> SMTLine\\n\\n    RepoInterfaces --> Entities\\n    DTOs --> Contracts\\n\\n    RepoImpls -.->|Implements| RepoInterfaces\\n    RepoImpls --> DbContext\\n    DbContext --> Entities\\n    DbContext --> JoinEntities\\n    DbContext --> SQLite\",\n  \"config\": null\n}"
