@page "/dev-tools"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["DevTools_PageTitle"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@T["DevTools_Heading"]</h1>
</div>

<p class="text-muted">@T["DevTools_Intro"]</p>

@if (_error is not null)
{
    <div class="alert alert-danger py-2">@_error</div>
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">@T["DevTools_ComponentsTitle"]</h5>
                <p class="card-text">@T["DevTools_ComponentsText"]</p>
                <label class="form-label small" for="compCount">@T["DevTools_Count"]</label>
                <input id="compCount" class="form-control mb-2" type="number" min="1" max="100"
                       @bind="_componentCount" />
                <button class="btn btn-primary" disabled="@_working"
                        @onclick="@(async _ => await MockComponentsAsync())">
                    @T["DevTools_Generate"]
                </button>
                <button class="btn btn-outline-danger" disabled="@_working"
                        @onclick="@(async _ => await ClearComponentsAsync())">
                    @T["DevTools_Clear"]
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">@T["DevTools_BoardsTitle"]</h5>
                <p class="card-text">@T["DevTools_BoardsText"]</p>
                <label class="form-label small" for="boardCount">@T["DevTools_Count"]</label>
                <input id="boardCount" class="form-control mb-2" type="number" min="1" max="50" @bind="_boardCount" />
                <button class="btn btn-primary" disabled="@_working" @onclick="@(async _ => await MockBoardsAsync())">
                    @T["DevTools_Generate"]
                </button>
                <button class="btn btn-outline-danger" disabled="@_working"
                        @onclick="@(async _ => await ClearBoardsAsync())">
                    @T["DevTools_Clear"]
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">@T["DevTools_OrdersTitle"]</h5>
                <p class="card-text">@T["DevTools_OrdersText"]</p>
                <label class="form-label small" for="orderCount">@T["DevTools_Count"]</label>
                <input id="orderCount" class="form-control mb-2" type="number" min="1" max="50" @bind="_orderCount" />
                <button class="btn btn-primary" disabled="@_working" @onclick="@(async _ => await MockOrdersAsync())">
                    @T["DevTools_Generate"]
                </button>
                <button class="btn btn-outline-danger" disabled="@_working"
                        @onclick="@(async _ => await ClearOrdersAsync())">
                    @T["DevTools_Clear"]
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 border-danger">
    <div class="card-body">
        <h5 class="card-title text-danger">@T["DevTools_ClearAllTitle"]</h5>
        <p class="card-text">@T["DevTools_ClearAllText"]</p>
        @if (_confirmClearAll)
        {
            <button class="btn btn-danger" disabled="@_working" @onclick="@(async _ => await ClearAllAsync())">
                @T["DevTools_ClearAllConfirm"]
            </button>
            <button class="btn btn-outline-secondary" disabled="@_working" @onclick="@(() => _confirmClearAll = false)">
                @T["List_Cancel"]
            </button>
        }
        else
        {
            <button class="btn btn-outline-danger" disabled="@_working" @onclick="@(() => _confirmClearAll = true)">
                @T["DevTools_ClearAll"]
            </button>
        }
    </div>
</div>

@if (_log.Count > 0)
{
    <div class="card mt-4">
        <div class="card-header">@T["DevTools_LogTitle"]</div>
        <div class="card-body">
            @foreach (var line in _log)
            {
                <div class="small">@line</div>
            }
        </div>
    </div>
}

@if (_working)
{
    <div class="spinner-border spinner-border-sm text-primary mt-3" role="status"></div>
}
