@page "/boards/new"
@page "/boards/{id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> T

<PageTitle>@(_isNew ? T["BoardEdit_NewTitle"] : T["BoardEdit_EditTitle"])@T["OrderEdit_PageTitleSuffix"]</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <h1 class="h3 mb-3">@(_isNew ? T["BoardEdit_NewTitle"] : T["BoardEdit_EditTitle"])</h1>

        @* Conflict banner: real-time via SignalR, or on save (HTTP 409). *@
        @if (_conflict is not null || _conflictState is not null)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                <div>
                    <strong>@T["OrderEdit_ConflictBanner"]</strong> @T["OrderEdit_ConflictModifiedBy"]
                    <strong>@(_conflict?.ModifiedBy ?? T["OrderEdit_ConflictAnotherUser"])</strong>@ConflictWhenSuffix
                    @if (_reviewing)
                    {
                        <div class="mt-2">
                            <table class="table table-sm table-bordered mb-2">
                                <thead>
                                    <tr>
                                        <th>@T["OrderEdit_Field"]</th>
                                        <th>@T["OrderEdit_YourChanges"]</th>
                                        <th>@T["OrderEdit_CurrentDatabase"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="@(_conflictState.Name != _form.Name ? "table-warning" : "")">
                                        <td>@T["List_Name"]</td>
                                        <td>@_form.Name</td>
                                        <td>@_conflictState.Name</td>
                                    </tr>
                                    <tr class="@(_conflictState.Description != _form.Description ? "table-warning" : "")">
                                        <td>@T["List_Description"]</td>
                                        <td>@_form.Description</td>
                                        <td>@_conflictState.Description</td>
                                    </tr>
                                    <tr class="@(_conflictState.Length != _form.Length ? "table-warning" : "")">
                                        <td>@T["BoardEdit_Length"]</td>
                                        <td>@_form.Length</td>
                                        <td>@_conflictState.Length</td>
                                    </tr>
                                    <tr class="@(_conflictState.Width != _form.Width ? "table-warning" : "")">
                                        <td>@T["BoardEdit_Width"]</td>
                                        <td>@_form.Width</td>
                                        <td>@_conflictState.Width</td>
                                    </tr>
                                    <tr class="@(ConflictPlacementsSummary != PlacementsSummary ? "table-warning" : "")">
                                        <td>@T["BoardEdit_PlacementsHeading"]</td>
                                        <td>@PlacementsSummary</td>
                                        <td>@ConflictPlacementsSummary</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="d-flex flex-column gap-2 ms-3" style="min-width: 11rem;">
                    @if (_reviewing)
                    {
                        <button class="btn btn-sm btn-danger"
                                @onclick="DiscardAndReloadAsync">@T["OrderEdit_DiscardReload"]</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="OverwriteAnywayAsync"
                                disabled="@_saving">@T["OrderEdit_OverwriteAnyway"]</button>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="@(e => _reviewing = false)">@T["OrderEdit_HideReview"]</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="@(e => _reviewing = true)">@T["OrderEdit_SideBySideReview"]</button>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="DiscardAndReloadAsync">@T["OrderEdit_DiscardReload"]</button>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="DismissConflict">@T["OrderEdit_KeepEditing"]</button>
                    }
                </div>
            </div>
        }

        @if (_notFound)
        {
            <div class="alert alert-warning">@T["BoardEdit_NotFound"]</div>
            <a class="btn btn-outline-secondary" href="boards">@T["Edit_BackToList"]</a>
        }
        else if (_loading)
        {
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        }
        else
        {
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@T["Edit_Name"] <span
                            class="text-danger">@T["Edit_Required"]</span></label>
                            <InputText @bind-Value="_form.Name" class="form-control" maxlength="200" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@T["BoardEdit_Length"] <span
                                class="text-danger">@T["Edit_Required"]</span></label>
                                <InputNumber @bind-Value="_form.Length" class="form-control" min="0" step="0.1" required />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">@T["BoardEdit_Width"] <span
                                    class="text-danger">@T["Edit_Required"]</span></label>
                                    <InputNumber @bind-Value="_form.Width" class="form-control" min="0" step="0.1" required />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@T["Edit_Description"]</label>
                                <InputTextArea @bind-Value="_form.Description" class="form-control" rows="2" />
                            </div>

                            <hr />
                            <AssignmentList Rows="_placements" Available="_availableComponents"
                                            Heading="@T["BoardEdit_PlacementsHeading"]" ItemColumnHeader="@T["BoardEdit_ComponentColumn"]"
                                            CountColumnHeader="@T["BoardEdit_PlacementCount"]" SelectPlaceholder="@T["BoardEdit_SelectComponent"]"
                                            RowHrefFactory="@(id => $"components/{id}")" OnChanged="StateChangedAsync" />

                            @if (_error is not null)
                            {
                                <div class="alert alert-danger py-2">@_error</div>
                            }

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@_saving">
                                    @(_saving ? T["Edit_Saving"] : T["Edit_Save"])
                                </button>
                                <a class="btn btn-outline-secondary" href="boards">@T["Edit_Cancel"]</a>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
