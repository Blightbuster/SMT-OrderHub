@page "/orders/new"
@page "/orders/{id:guid}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@(_isNew ? "New order" : "Edit order") — OrderHub</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <h1 class="h3 mb-3">@(_isNew ? "New order" : "Edit order")</h1>

        @* Real-time conflict banner: shown when another user modifies this order. *@
        @if (_conflict is not null)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                <div>
                    <strong>Concurrency conflict:</strong> this order was modified by
                    <strong>@_conflict.ModifiedBy</strong> at @_conflict.ModifiedAtUtc.ToLocalTime().ToString("HH:mm:ss").
                    @if (_reviewing)
                    {
                        <div class="mt-2">
                            <table class="table table-sm table-bordered mb-2">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Your changes</th>
                                        <th>Current database</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="@(_conflictState?.Name != _form.Name ? "table-warning" : "")">
                                        <td>Name</td>
                                        <td>@_form.Name</td>
                                        <td>@_conflictState?.Name</td>
                                    </tr>
                                    <tr class="@(_conflictState?.Description != _form.Description ? "table-warning" : "")">
                                        <td>Description</td>
                                        <td>@_form.Description</td>
                                        <td>@_conflictState?.Description</td>
                                    </tr>
                                    <tr class="@(_conflictBoardSummary != _conflictStateSummary ? "table-warning" : "")">
                                        <td>Boards</td>
                                        <td>@_conflictBoardSummary</td>
                                        <td>@_conflictStateSummary</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="d-flex flex-column gap-2 ms-3" style="min-width: 11rem;">
                    @if (_reviewing)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="DiscardAndReloadAsync">Discard &amp; reload</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="OverwriteAnywayAsync"
                                disabled="@_saving">Overwrite anyway</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(e => _reviewing = false)">Hide
                            review</button>
                        }
                    else
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="@(e => _reviewing = true)">Side-by-side
                                review</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="DiscardAndReloadAsync">Discard &amp;
                                    reload</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="DismissConflict">Keep editing</button>
                                }
                            </div>
                        </div>
                    }

                    @if (_notFound)
                    {
                        <div class="alert alert-warning">This order no longer exists.</div>
                        <a class="btn btn-outline-secondary" href="orders">Back to list</a>
                    }
                    else if (_loading)
                    {
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    }
                    else
                    {
                        <EditForm Model="_form" OnValidSubmit="SaveAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_form.Name" class="form-control" maxlength="200" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <InputTextArea @bind-Value="_form.Description" class="form-control" rows="2" />
                            </div>

                            <hr />
                            <AssignmentList Rows="_boardAssignments" Available="_availableBoards" Heading="Boards"
                                            ItemColumnHeader="Board" CountColumnHeader="Board quantity" SelectPlaceholder="Select board…"
                                            OnChanged="StateChangedAsync" />

                            @if (_error is not null)
                            {
                                <div class="alert alert-danger py-2">@_error</div>
                            }

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@_saving">
                                    @(_saving ? "Saving…" : "Save")
                                </button>
                                <a class="btn btn-outline-secondary" href="orders">Cancel</a>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
