@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["Login_PageTitle"]</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <h1 class="h3 mb-3">@T["Login_Heading"]</h1>

        <div class="btn-group w-100 mb-3" role="group">
            <button class="btn @(Mode == "login" ? "btn-primary" : "btn-outline-primary")"
                    @onclick="@(e => SetMode("login"))">@T["Login_SignIn"]</button>
            <button class="btn @(Mode == "register" ? "btn-primary" : "btn-outline-primary")"
                    @onclick="@(e => SetMode("register"))">@T["Login_Register"]</button>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <EditForm Model="this" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">@T["Login_Email"]</label>
                <InputText @bind-Value="_email" class="form-control" type="email" required />
            </div>
            <div class="mb-3">
                <label class="form-label">@T["Login_Password"]</label>
                @* Plain input with oninput: re-evaluate the rules on every
                   keystroke so satisfied requirements turn green while typing. *@
                <input class="form-control" type="password" required value="@_password" @oninput="OnPasswordInput" />
                @if (Mode == "register")
                {
                    <ul class="list-unstyled small mt-2 mb-0">
                        @foreach (var (label, met) in PasswordRules)
                        {
                            <li class="@(met ? "text-success" : "text-secondary")">
                                <span aria-hidden="true">@(met ? "✓" : "○")</span> @label()
                            </li>
                        }
                    </ul>
                }
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                @(_busy ? T["Login_PleaseWait"] : (Mode == "login" ? T["Login_SignIn"] : T["Login_CreateAccount"]))
            </button>
        </EditForm>
    </div>
</div>
