@page "/orders"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["Orders_PageTitle"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@T["Orders_Heading"]</h1>
    <a class="btn btn-primary" href="orders/new">@T["Orders_New"]</a>
</div>

<div class="input-group mb-3" style="max-width: 24rem;">
    <input class="form-control" placeholder="@T["List_SearchPlaceholder"]" value="@_searchTerm" @oninput="OnSearchInput" />
    @if (!string.IsNullOrEmpty(_searchTerm))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch">×</button>
    }
</div>

@if (_error is not null)
{
    <div class="alert alert-danger py-2">@_error</div>
}

@if (_loading)
{
    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
}
else if (_items.Count == 0)
{
    <p class="text-muted">@T["Orders_NoneFound"]@(string.IsNullOrEmpty(_searchTerm) ? T["List_NoResultsSuffix"] : T["List_MatchingSearch", _searchTerm])</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>@T["List_Name"]</th>
                <th>@T["List_Description"]</th>
                <th>@T["Orders_OrderDate"]</th>
                <th style="width: 15rem;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-muted">@item.Description</td>
                    <td>@item.OrderDate.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="@($"orders/{item.Id}")">@T["List_Details"]</a>
                        <a class="btn btn-sm btn-outline-primary" href="@($"orders/{item.Id}/edit")">@T["List_Edit"]</a>
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="@(e => ConfirmDeleteAsync(item))">@T["List_Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Pager State="@_pager" OnChanged="LoadAsync" />
}

@if (_pendingDelete is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T["Orders_DeleteTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>@T["List_DeleteConfirm", _pendingDelete.Name]</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CancelDelete">@T["List_Cancel"]</button>
                    <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@_deleting">@T["List_Delete"]</button>
                </div>
            </div>
        </div>
    </div>
}
