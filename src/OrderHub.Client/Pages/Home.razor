@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["Home_Title"]</PageTitle>

<h2 class="h4 mb-4 text-center">@T["Home_FeaturesHeading"]</h2>

<div class="row g-4 justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2" aria-hidden="true">📋</div>
                <h3 class="h5 card-title">@T["Home_FeatureOrdersTitle"]</h3>
                <p class="card-text text-muted">@T["Home_FeatureOrdersText"]</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2" aria-hidden="true">🔧</div>
                <h3 class="h5 card-title">@T["Home_FeatureBoardsTitle"]</h3>
                <p class="card-text text-muted">@T["Home_FeatureBoardsText"]</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2" aria-hidden="true">⚙️</div>
                <h3 class="h5 card-title">@T["Home_FeatureComponentsTitle"]</h3>
                <p class="card-text text-muted">@T["Home_FeatureComponentsText"]</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2" aria-hidden="true">🔍</div>
                <h3 class="h5 card-title">@T["Home_FeatureSearchTitle"]</h3>
                <p class="card-text text-muted">@T["Home_FeatureSearchText"]</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2" aria-hidden="true">📡</div>
                <h3 class="h5 card-title">@T["Home_FeatureRealtimeTitle"]</h3>
                <p class="card-text text-muted">@T["Home_FeatureRealtimeText"]</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2" aria-hidden="true">📤</div>
                <h3 class="h5 card-title">@T["Home_FeatureExportTitle"]</h3>
                <p class="card-text text-muted">@T["Home_FeatureExportText"]</p>
            </div>
        </div>
    </div>
</div>
