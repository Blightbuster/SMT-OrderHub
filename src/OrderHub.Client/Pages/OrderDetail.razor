@page "/orders/{id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["OrderDetail_PageTitle"]</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        @if (_notFound)
        {
            <div class="alert alert-warning">@T["OrderDetail_NotFound"]</div>
            <a class="btn btn-outline-secondary" href="orders">@T["Edit_BackToList"]</a>
        }
        else if (_loading)
        {
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        }
        else if (_order is not null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h3 mb-0">@_order.Name</h1>
                <a class="btn btn-outline-primary" href="@($"orders/{_order.Id}/edit")">@T["List_Edit"]</a>
            </div>

            <p class="text-muted">@_order.Description</p>
            <p class="small text-muted">@T["OrderDetail_Created", _order.OrderDate.ToString("yyyy-MM-dd HH:mm")]</p>

            <h2 class="h5 mt-4">@T["OrderDetail_BoardsHeading", _order.Boards.Count]</h2>
            @if (_order.Boards.Count == 0)
            {
                <p class="text-muted small">@T["OrderDetail_NoBoards"]</p>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@T["OrderDetail_BoardColumn"]</th>
                            <th class="text-end">@T["OrderDetail_Quantity"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var board in _order.Boards)
                        {
                            <tr>
                                <td><a href="@($"boards/{board.BoardId}")">@board.BoardName</a></td>
                                <td class="text-end">@board.BoardQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <hr />
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-success" @onclick="ExportAsync" disabled="@_exporting">
                    @(_exporting ? T["OrderDetail_Preparing"] : T["OrderDetail_Export"])
                </button>
                <span class="small text-muted">@T["OrderDetail_ExportHint"]</span>
            </div>

            @if (_exportError is not null)
            {
                <div class="alert alert-danger py-2 mt-3">@_exportError</div>
            }
        }
    </div>
</div>
