@namespace OrderHub.Client.Layout
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrderHub.Client.Resources.SharedResource> T

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">OrderHub.Client</a>
        <button title="@T["Nav_NavigationMenu"]" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @T["Nav_Home"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="orders">
                <span class="bi bi-list-columns-reverse-nav-menu" aria-hidden="true"></span> @T["Nav_Orders"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="boards">
                <span class="bi bi-motherboard-fill-nav-menu" aria-hidden="true"></span> @T["Nav_Boards"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="components">
                <span class="bi bi-cpu-fill-nav-menu" aria-hidden="true"></span> @T["Nav_Components"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dev-tools">
                <span class="bi bi-database-fill-gear-nav-menu" aria-hidden="true"></span> @T["Nav_DevTools"]
            </NavLink>
        </div>
    </nav>

    @* Signed-in user block pinned to the bottom of the sidebar. *@
    <div class="nav-footer px-3">
        <AuthorizeView>
            <div class="nav-user">
                <span class="nav-user-avatar" aria-hidden="true">
                    @char.ToUpperInvariant((context.User.Identity?.Name ?? "?")[0])
                </span>
                <span class="nav-user-name text-truncate" title="@context.User.Identity?.Name">
                    @context.User.Identity?.Name
                </span>
            </div>
            <button class="btn btn-sm btn-outline-light w-100" @onclick="LogoutAsync" disabled="@_loggingOut">
                @(_loggingOut ? T["Layout_SigningOut"] : T["Layout_SignOut"])
            </button>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool _loggingOut;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    [Inject] private OrderHub.Client.ApiClient.IOrderHubApiClient Api { get; set; } = null!;
    [Inject]
    private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState { get; set; } =
null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private async Task LogoutAsync()
    {
        _loggingOut = true;
        try
        {
            await Api.Auth.LogoutAsync();
        }
        catch
        {
            // Even if the API call fails, clear local state and return to login.
        }
        finally
        {
            ((OrderHub.Client.Auth.CookieAuthStateProvider)AuthState).NotifyStateChanged();
            Navigation.NavigateTo("login");
        }
    }
}
