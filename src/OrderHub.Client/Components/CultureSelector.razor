@namespace OrderHub.Client.Components
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrderHub.Client.Resources.SharedResource> T
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Runtime culture selector. The choice is persisted in localStorage ("appCulture")
   and the page is force-reloaded so Program.cs applies the culture before any
   component renders. Resource lookup falls back to SharedResource.resx (English)
   for any key missing in the selected satellite file. *@

@if (SupportedCultures.All.Length > 1)
{
    <div class="culture-select-wrap">
        <span class="bi-globe" aria-hidden="true"></span>
        <select class="culture-select" value="@GetCurrentCulture()" @onchange="OnCultureChanged"
                aria-label="@T["Nav_CultureSelector"]">
            @foreach (var culture in SupportedCultures.All)
            {
                <option value="@culture">@GetDisplayName(culture)</option>
            }
        </select>
    </div>
}

@code {
    private string GetCurrentCulture()
    {
        var current = System.Globalization.CultureInfo.CurrentUICulture.Name;
        return SupportedCultures.All.Contains(current) ? current : SupportedCultures.Default;
    }

    private static string GetDisplayName(string culture) => culture switch
    {
        "en" => "English",
        "zh" => "7 Seas",
        _ => culture,
    };

    private async Task OnCultureChanged(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString();
        if (string.IsNullOrEmpty(culture) || culture == GetCurrentCulture())
        {
            return;
        }

        await JS.InvokeVoidAsync("localStorage.setItem", "appCulture", culture);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
