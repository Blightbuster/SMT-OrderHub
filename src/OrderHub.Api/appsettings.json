{
  "ConnectionStrings": {
    "SmtDatabase": "Data Source=orderhub.db"
  },
  "Cors": {
    "AllowedOrigins": "https://localhost:7182, http://localhost:5106"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
